#!name=节点探活
#!desc=定时检测指定Loon节点是否正常

[Argument]
node_name = input,"",tag=节点名称,desc=填写Loon中准确的节点名称
timeout_ms = input,"4000",tag=HTTP超时(ms)
interval = select,"0 */3 * * *","0 * */6 * *","0 * */12 * *",tag=探测频率,desc=每3小时/每6小时/每12小时

[Script]
cron {interval} script-path=https://raw.githubusercontent.com/Gluvyi/QuanX/refs/heads/main/node_ping.js,timeout=20,tag=指定节点探活,argument=[{node_name},{timeout_ms}]
