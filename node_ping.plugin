[Argument]
node_name = input,"",tag=节点名称,desc=填Loon里准确的节点名(含emoji/空格)
interval = select,"*/5 * * * *","*/3 * * * *","0 * * * *",tag=探测频率,desc=cron表达式
timeout_ms = input,"4000",tag=HTTP超时(ms)

[Script]
cron "{interval}" script-path=https://raw.githubusercontent.com/Gluvyi/QuanX/refs/heads/main/node_ping.js, tag=指定节点探活, timeout=20, enable=true, argument="node={node_name}&timeout={timeout_ms}"
